{
  "name": "veil-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5196",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4196",
    "test": "tsc -p tsconfig.test.json && node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests index.html *.md"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "@playwright/test": "^1.63.0",
    "prettier": "^3.9.6",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0"
  }
}
